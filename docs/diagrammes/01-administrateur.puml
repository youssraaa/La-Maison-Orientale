@startuml Diagramme_Administrateur
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF9C4
  BorderColor #333
}

title Restaurant La Maison Orientale — Administrateur

actor "Administrateur" as Admin

rectangle "Restaurant La Maison Orientale" {
  usecase "UC01 : consulter le\n tableau de bord" as UC01
  usecase "UC01-01 : générer un rapport\nd'activité PDF" as UC01_01

  usecase "UC02 : gérer les agents" as UC02
  usecase "UC02-01 : créer un compte agent" as UC02_01
  usecase "UC02-02 : modifier un compte agent" as UC02_02
  usecase "UC02-03 : supprimer un compte agent" as UC02_03
  usecase "UC02-04 : renvoyer une invitation" as UC02_04
  usecase "UC02-05 : réinitialiser le\nmot de passe agent" as UC02_05

  usecase "UC03 : consulter les\nnotifications" as UC03
  usecase "UC04 : gérer son profil" as UC04
}

Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04

UC01 ..> UC01_01 : <<extend>>
UC02 ..> UC02_01 : <<include>>
UC02 ..> UC02_02 : <<include>>
UC02 ..> UC02_03 : <<include>>
UC02 ..> UC02_04 : <<include>>
UC02 ..> UC02_05 : <<include>>

note right of UC02
  L'administrateur ne gère pas
  les réservations, commandes
  ou la carte (rôle Agent).
end note

@enduml
