# Copier vers .env :  copy .env.example .env
# Ne jamais committer .env (secrets SMTP)

DB_NAME=la_maison_orientale
DB_USER=postgres
DB_PASSWORD=postgres123
DB_PORT_HOST=5433

PGADMIN_EMAIL=admin@lamaisonorientale.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# --- E-mail (Brevo SMTP — comme GLOP Prima Vision) ---
# Compte gratuit : https://www.brevo.com → SMTP & API → identifiants SMTP
# MAIL_USERNAME = login SMTP Brevo | MAIL_PASSWORD = clé SMTP (pas le mot de passe du site)
# MAIL_FROM = expéditeur vérifié dans Brevo
# MAIL_RESTAURANT_TO = boîte de réception test (ex. Yopmail : lamaisonorientale@yopmail.com)

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_RESTAURANT_TO=lamaisonorientale@yopmail.com

# --- Auth admin (JWT + compte seed, comme GLOP) ---
# Changer JWT_SECRET_KEY et LMO_ADMIN_PASSWORD en production
JWT_SECRET_KEY=5357ef4109843d66b24a19167ff9d1a7be6ec7cc2573a338aa6aca565ab0bae4
JWT_EXPIRATION_MS=86400000
LMO_ADMIN_EMAIL=admin@lamaisonorientale.be
LMO_ADMIN_PASSWORD=admin123
LMO_ADMIN_NOM=Administrateur

SPRING_PROFILES_ACTIVE=local
